{
  "name": "pincer",
  "version": "0.3.0",
  "private": true,
  "author": "ZitZdorovo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZitZdorovo/Pincer.git"
  },
  "description": "Native desktop operator and node for an existing OpenClaw Gateway",
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "start": "node scripts/start.mjs",
    "dev": "npm run build && npm start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@openclaw/gateway-client": "2026.8.2",
    "@openclaw/gateway-protocol": "2026.8.2",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron-updater": "6.8.3",
    "framer-motion": "12.34.2",
    "i18next": "25.8.11",
    "katex": "0.16.45",
    "lucide-react": "0.563.0",
    "material-file-icons": "2.4.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "16.5.4",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.3",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.7",
    "streamdown": "2.5.0",
    "tailwind-merge": "2.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "25.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.1.4",
    "autoprefixer": "10.4.24",
    "electron": "40.10.6",
    "electron-builder": "26.8.1",
    "esbuild": "0.25.12",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18",
    "ws": "8.21.3"
  },
  "allowScripts": {
    "electron@40.10.6": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true
  }
}
